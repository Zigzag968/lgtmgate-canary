    "extraLinks": []
  },
  "preflight": {
    "canonicalStringBan": [],
    "envSymlink": "required"
  },
  "planAudit": false,
  "planFreshness": "advisory",
  "stack": "Node 22 / CommonJS, stdlib only (node:test)",
  "projectSpecifics": ".claude/lgtmgate",
  "minPluginVersion": "1.3.0-beta.45",
  "agentContext": { "*": [] },
  "specifics": { "acceptOversize": {} }
}
