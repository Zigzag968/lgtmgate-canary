{
  "baseBranch": "main",
  "branchPrefix": "feat/",
  "worktreeRoot": "../worktrees/lgtmgate-canary",
  "commands": {
    "build": "npm run build",
    "test": "npm test",
    "format": "npm run format"
  },
  "ciChecks": ["test"],
  "regressionGuard": {
    "testGlob": "test/*.test.js",
    "testFnPattern": "test(",
